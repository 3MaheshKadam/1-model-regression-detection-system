# Default provider (runner.py --provider groq). Free — no card required.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Only needed if you switch back with --provider openai (requires billing/credits).
OPENAI_API_KEY=sk-...

# Only needed once eval/notify.py (step 8) is built.
SLACK_WEBHOOK_URL=
